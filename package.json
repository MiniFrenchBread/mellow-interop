{
    "name": "mellow-lz-cross-chain",
    "license": "BUSL-1.1",
    "version": "1.0.0",
    "repository": "https://github.com/mellow-finance/mellow-lz-cross-chain",
    "scripts": {
      "compile": "forge build",
      "prettier": "forge fmt && forge fmt ./scripts/**",
      "sizes": "forge build --sizes --force",
      "test": "forge test -vvv --fork-url $(grep HOLESKY_RPC .env | cut -d '=' -f2,3,4,5) --fork-block-number 2531704",
      "coverage": "forge coverage --force --fork-url $(grep HOLESKY_RPC .env | cut -d '=' -f2,3,4,5) --fork-block-number 2531704",
      "coverage:report": "forge coverage --force --fork-url $(grep HOLESKY_RPC .env | cut -d '=' -f2,3,4,5) --fork-block-number 2531704 --report lcov && genhtml lcov.info -o report --branch-coverage && rm lcov.info"
    }
  }